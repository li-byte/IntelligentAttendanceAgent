APP_RO_USER=app_ro
APP_RO_PASSWORD=app_ro_pwd
# app_rw：仅供 LangGraph checkpointer 读写
APP_RW_USER=app_rw
APP_RW_PASSWORD=app_rw_pwd

# ============ 应用参数 ============
STATEMENT_TIMEOUT_MS=5000
MAX_ROWS=200
MAX_RESULT_BYTES=50000
TOKEN_SECRET=dev-secret-change-me
