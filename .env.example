# ============ DeepSeek 大模型 ============
DEEPSEEK_API_KEY=sk-
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============ PostgreSQL（建表/灌数据用超级用户）============
PG_HOST=192.168.10.101
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres.2024.1.23
PG_DB=punch_in

# ============ 运行时角色（由 scripts/setup_db.py 创建）============
